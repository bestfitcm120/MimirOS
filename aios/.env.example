# ═══════════════════════════════════════════════════════════
#  AIOS — Environment Configuration
#  Copy to .env and fill in the values marked REQUIRED.
#  All database/redis/minio URLs are set automatically by
#  docker-compose.yml using the internal Docker network.
# ═══════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=change_this_to_any_random_string
CORS_ORIGINS=http://localhost
APP_SITE_NAME=AIOS Command Center
APP_SITE_URL=http://localhost

# ── PostgreSQL ────────────────────────────────────────────
# These are used by docker-compose to create the database.
# The backend connects via the internal hostname "postgres".
POSTGRES_USER=aios
POSTGRES_PASSWORD=aios_secret
POSTGRES_DB=aios_db

# ── MinIO (file storage) ──────────────────────────────────
MINIO_ACCESS_KEY=aios_minio
MINIO_SECRET_KEY=aios_minio_secret
MINIO_BUCKET=aios-files

# ══════════════════════════════════════════════════════════
#  REQUIRED: OpenRouter API Key
#  Get yours free at https://openrouter.ai/keys
# ══════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM model — any model ID from https://openrouter.ai/models
# Free options (no billing required):
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
#   google/gemma-2-9b-it:free
# Paid (better quality):
#   anthropic/claude-haiku-4-5-20251001
#   openai/gpt-4o-mini
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Embeddings ────────────────────────────────────────────
# OpenRouter does not support embeddings.
# "local" runs sentence-transformers on CPU — no API key needed.
# "openai" uses OpenAI directly — requires EMBEDDING_OPENAI_API_KEY.
# "none"  disables vector search (keyword search still works).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Only needed if EMBEDDING_PROVIDER=openai:
EMBEDDING_OPENAI_API_KEY=
EMBEDDING_OPENAI_MODEL=text-embedding-3-small

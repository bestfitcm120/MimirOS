# ═══════════════════════════════════════════════════════════
#  AIOS — Environment Configuration
#  Copy to .env and fill in your values.
#  Lines starting with # are comments.
# ═══════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_string_in_production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_SITE_NAME=AIOS Command Center
APP_SITE_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aios:aios_secret@localhost:5432/aios_db
DATABASE_URL_SYNC=postgresql://aios:aios_secret@localhost:5432/aios_db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO (local file storage) ────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aios_minio
MINIO_SECRET_KEY=aios_minio_secret
MINIO_BUCKET=aios-files
MINIO_SECURE=false

# ══════════════════════════════════════════════════════════
#  LLM — OpenRouter
#  Get your key at https://openrouter.ai/keys
#  Free tier available — no credit card required for free models.
# ══════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to use for all AI completions.
# ── Free models (no cost, rate-limited) ──────────────────
# meta-llama/llama-3.1-8b-instruct:free
# meta-llama/llama-3.2-3b-instruct:free
# mistralai/mistral-7b-instruct:free
# google/gemma-2-9b-it:free
# qwen/qwen-2.5-7b-instruct:free
#
# ── Paid models (better quality) ─────────────────────────
# anthropic/claude-sonnet-4-5
# anthropic/claude-haiku-4-5-20251001
# openai/gpt-4o-mini
# openai/gpt-4o
# google/gemini-flash-1.5
# mistralai/mistral-large
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ══════════════════════════════════════════════════════════
#  Embeddings
#  OpenRouter does NOT support embeddings.
#  Choose one provider below.
# ══════════════════════════════════════════════════════════

# Provider: local | openai | none
#
#   local  — runs sentence-transformers on your CPU (recommended).
#            No API key needed. ~22 MB model download on first run.
#            Install: pip install sentence-transformers
#
#   openai — uses OpenAI /embeddings directly (NOT through OpenRouter).
#            Better quality (1536-dim vs 384-dim) but costs money.
#            Requires EMBEDDING_OPENAI_API_KEY below.
#
#   none   — disables vector search entirely.
#            Regular keyword search still works.
EMBEDDING_PROVIDER=local

# Model name for local provider (sentence-transformers model ID)
# Good options:
#   all-MiniLM-L6-v2        — fast, 384-dim, 22 MB  (default)
#   all-mpnet-base-v2       — better quality, 768-dim, 420 MB
#   paraphrase-multilingual-MiniLM-L12-v2  — multilingual
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Only needed if EMBEDDING_PROVIDER=openai
EMBEDDING_OPENAI_API_KEY=
EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# ── Linux File Watcher (optional) ─────────────────────────
# Comma-separated directories to watch for new/changed files
WATCH_DIRECTORIES=/home/$USER/projects,/home/$USER/documents
SHELL_COMMAND_WHITELIST=git,python3,ls,cat,find,grep

# Your user UUID — create one via: POST /api/users/
# Then paste the returned id here
AIOS_USER_ID=
